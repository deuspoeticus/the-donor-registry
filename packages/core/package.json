    "check": "tsx scripts/check.ts",
    "emit": "tsx scripts/emit.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
