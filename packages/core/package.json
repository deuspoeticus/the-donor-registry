{
  "name": "@wearme/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isomorphic core: attribute manifest, canonical hashing, entropy, Chow-Liu forge, userscript template.",
  "main": "./src/index.ts",
