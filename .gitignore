node_modules/
dist/
# The live pool's published snapshot and its per-entry install links.
# Regenerated from D1 and deployed on every publish-pool.yml run; never
# committed, because a committed snapshot would make a withdrawn identity
# recoverable from git history forever regardless of what the live site shows
# (apps/worker/scripts/publish-pool.ts has the full reasoning). Only the
# offline, synthetic, donor-free `data/bootstrap.json` and its matching
# `data/scripts/` seed files stay committed — this line does not touch those,
# since they are written to disk before the live pool's are and are never
# regenerated by the same command that would need to overwrite them.
data/pool.json
# Generated from data/bootstrap.json by @wearme/worker's seed:build.
apps/worker/seed/
# wrangler build output and local D1 state.
apps/worker/.dryrun/
apps/worker/.wrangler/
# Local secrets for `wrangler dev`. The deployed values are set with
# `wrangler secret put` and live only in Cloudflare.
apps/worker/.dev.vars
*.db
*.db-shm
*.db-wal
.DS_Store
.claude/settings.local.json
